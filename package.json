{
  "name": "youtube-comments-extractor",
  "version": "1.0.0",
  "description": "Turnkey YouTube comments extractor with CLI + lightweight GUI",
  "type": "commonjs",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "build": "pkg . --targets node18-win-x64 --output dist/youtube-comments-extractor.exe"
  },
  "dependencies": {},
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "assets": [
      "src/gui/public/*"
    ],
    "outputPath": "dist"
  }
}
